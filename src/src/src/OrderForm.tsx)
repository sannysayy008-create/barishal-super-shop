import React, { useState } from 'react';

export default function OrderForm() {
  const [formData, setFormData] = useState({
    name: '',
    phone: '',
    address: '',
    productName: '',
    quantity: '1',
  });

  const [submitted, setSubmitted] = useState(false);

  const handleChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement>) => {
    setFormData({ ...formData, [e.target.name]: e.target.value });
  };

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    setSubmitted(true);
    // এখানে চাইলে আপনি টেলিগ্রাম বট বা ব্যাকএন্ডে ডেটা পাঠানোর লজিক যুক্ত করতে পারেন
  };

  return (
    <div className="bg-white p-4 rounded-xl shadow-sm max-w-md mx-auto my-2 text-xs">
      <h3 className="font-bold text-sm text-pink-600 border-b pb-2 mb-3">📦 অর্ডার কনফার্ম করুন</h3>

      {submitted ? (
        <div className="text-center py-6 space-y-2">
          <div className="text-3xl">✅</div>
          <p className="font-bold text-green-600 text-sm">আপনার অর্ডারটি সফলভাবে গ্রহণ করা হয়েছে!</p>
          <p className="text-gray-500 text-[10px]">খুব শীঘ্রই আমরা আপনার সাথে যোগাযোগ করব।</p>
          <button 
            onClick={() => setSubmitted(false)} 
            className="mt-3 bg-pink-600 text-white px-4 py-1.5 rounded-full font-bold text-xs"
          >
            আরেকটি অর্ডার করুন
          </button>
        </div>
      ) : (
        <form onSubmit={handleSubmit} className="space-y-3">
          <div>
            <label className="block text-gray-700 font-medium mb-1">আপনার নাম</label>
            <input
              type="text"
              name="name"
              required
              value={formData.name}
              onChange={handleChange}
              placeholder="পূর্ণ নাম লিখুন"
              className="w-full border rounded p-2 text-xs outline-none focus:border-pink-600"
            />
          </div>

          <div>
            <label className="block text-gray-700 font-medium mb-1">মোবাইল নাম্বার</label>
            <input
              type="tel"
              name="phone"
              required
              value={formData.phone}
              onChange={handleChange}
              placeholder="০১XXXXXXXXX"
              className="w-full border rounded p-2 text-xs outline-none focus:border-pink-600"
            />
          </div>

          <div>
            <label className="block text-gray-700 font-medium mb-1">পণ্যের নাম / বিবরণ</label>
            <input
              type="text"
              name="productName"
              required
              value={formData.productName}
              onChange={handleChange}
              placeholder="যেমন: ব্যাকপ্যাক ব্যাগ"
              className="w-full border rounded p-2 text-xs outline-none focus:border-pink-600"
            />
          </div>

          <div>
            <label className="block text-gray-700 font-medium mb-1">পরিমাণ</label>
            <input
              type="number"
              name="quantity"
              min="1"
              value={formData.quantity}
              onChange={handleChange}
              className="w-full border rounded p-2 text-xs outline-none focus:border-pink-600"
            />
          </div>

          <div>
            <label className="block text-gray-700 font-medium mb-1">পূর্ণ ঠিকানা</label>
            <textarea
              name="address"
              required
              rows={2}
              value={formData.address}
              onChange={handleChange}
              placeholder="বাসা/রোড, থানা, জেলা (যেমন: বরিশাল সদর, বরিশাল)"
              className="w-full border rounded p-2 text-xs outline-none focus:border-pink-600"
            />
          </div>

          <button
            type="submit"
            className="w-full bg-pink-600 text-white py-2 rounded-lg font-bold text-xs shadow hover:bg-pink-700 transition"
          >
            অর্ডার কনফার্ম করুন
          </button>
        </form>
      )}
    </div>
  );
}
