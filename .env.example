# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# API Configuration
VITE_API_BASE_URL=http://localhost:3000
VITE_API_TIMEOUT=30000

# Telegram Notifications (Store securely in .env.local)
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
VITE_TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Payment Gateway Keys
VITE_STRIPE_PUBLIC_KEY=your_stripe_public_key_here
VITE_SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id_here
VITE_SSLCOMMERZ_STORE_PASSWORD=your_sslcommerz_store_password_here

# Maps & Location
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# App Settings
VITE_APP_NAME=বরিশাল সুপার শপ
VITE_SUPPORT_EMAIL=support@barishal-super-shop.com
VITE_SUPPORT_PHONE=+880xxxxxxxxxx
